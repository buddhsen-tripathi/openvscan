{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openvscan-web",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "vars": {
    "VITE_APP_URL": "https://openvscan.com",
    // WorkOS AuthKit (sign-in): WORKOS_CLIENT_ID and WORKOS_API_KEY are
    // secrets (`wrangler secret put`). AuthKit domain for the MCP server's
    // OAuth; empty turns /mcp off.
    "WORKOS_AUTHKIT_DOMAIN": "committed-intention-27.authkit.app"
  },
  // Brute-force limits for the sign-in, sign-up, code and password reset
  // forms (WorkOS's password API has no lockout of its own). Keys are the
  // client IP and the email address. `namespace_id` is any number unique to
  // your Cloudflare account.
  "ratelimits": [
    {
      "name": "AUTH_IP_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AUTH_EMAIL_LIMITER",
      "namespace_id": "4202",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openvscan",
      "database_id": "8b891571-fba1-4760-b2ba-a7c089b7e816",
      "migrations_dir": "../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "openvscan-artifacts"
    }
  ],
  // RPC into the engine Worker (ReviewWorkflow + scanner/agent sandboxes).
  // The web Worker creates `run` rows and hands their ids to ENGINE.startRun.
  "services": [
    {
      "binding": "ENGINE",
      "service": "openvscan-engine",
      "entrypoint": "EngineApi"
    }
  ]
}
