{
  "name": "openvscan",
  "version": "1.0.0",
  "private": true,
  "description": "OpenVScan - open-source security review for pull requests: scanners plus your own coding agent, on Cloudflare",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter openvscan-web dev",
    "dev:engine": "pnpm --filter openvscan-engine dev",
    "build": "pnpm --filter openvscan-web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter openvscan-engine test",
    "lint": "pnpm --filter openvscan-web lint",
    "deploy": "pnpm deploy:engine && pnpm deploy:web",
    "deploy:engine": "pnpm --filter openvscan-engine run deploy",
    "deploy:web": "pnpm --filter openvscan-web run deploy",
    "db:generate": "pnpm --filter @openvscan/db generate",
    "db:migrate": "pnpm --filter openvscan-web exec wrangler d1 migrations apply openvscan --remote",
    "db:migrate:local": "pnpm --filter openvscan-web exec wrangler d1 migrations apply openvscan --local"
  },
  "keywords": [
    "security",
    "code-review",
    "pull-requests",
    "sast",
    "claude-code",
    "codex",
    "cloudflare-workers"
  ],
  "author": "Buddhsen Tripathi",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Buddhsen-tripathi/openvscan.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  }
}
